# Copie para .env e substitua o placeholder de senha antes de iniciar.
# A API recebe PG* derivados de POSTGRES_*; não duplique as credenciais.
# PORT publica somente a API em 127.0.0.1; internamente ela usa 3000.
PORT=3000
POSTGRES_DB=reservas
POSTGRES_USER=reservas
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_LOCAL
